    LTEXT           "Password:",IDC_STATIC,0,30,185,8
    EDITTEXT        IDC_PASSWORD,0,40,185,12,ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "Your OK friends appear as contacts. Existing group chats open as chat rooms.",IDC_STATIC,0,58,185,18
END

IDD_OPTIONS DIALOGEX 0, 0, 305, 110
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    GROUPBOX        "Account",IDC_STATIC,7,7,291,55
    LTEXT           "Login (e-mail, phone or user name):",IDC_STATIC,15,22,120,8
    EDITTEXT        IDC_LOGIN,140,20,150,12,ES_AUTOHSCROLL
    LTEXT           "Password:",IDC_STATIC,15,40,120,8
    EDITTEXT        IDC_PASSWORD,140,38,150,12,ES_PASSWORD | ES_AUTOHSCROLL
    GROUPBOX        "Connection",IDC_STATIC,7,67,291,35
